-- Copy this file to lua/mars/local.lua (gitignored) to customize Mars
-- without ever having to commit or maintain a diff against a tracked file.
--
-- Loaded last, after every core/plugins/ui/lang module, so it can override
-- anything set above: options, globals, keymaps, even plugin config by
-- calling require("plugin").setup({...}) again with your own values.

-- vim.g.have_nerd_font = true

-- Skip Unicode diagnostic symbols in favor of plain ASCII letters, for
-- terminals/log viewers that don't render Unicode reliably.
-- vim.g.mars_ascii_diagnostics = true

-- Floating window border style: "rounded" (default) | "single" | "solid" | "none"
-- vim.g.mars_border_style = "single"
-- require("mars.ui.borders").setup()

-- Disable the start screen shown on a bare `nvim` invocation.
-- vim.g.mars_dashboard_enabled = false

-- Side the file explorer sidebar opens on: "left" (default) | "right"
-- vim.g.mars_explorer_position = "right"

-- vim.o.scrolloff = 8

-- vim.keymap.set("n", "<leader>qq", "<cmd>qa<cr>", { desc = "Quit all" })
